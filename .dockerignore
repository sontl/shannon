# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime directories
sessions/
deliverables/
xben-benchmark-results/
.claude/
# Output + input dirs — bind-mounted at runtime (docker-compose volumes), so
# baking them into the image is pure waste. audit-logs in particular grows
# every run; left un-ignored it balloons the image build over time.
audit-logs/
repos/
credentials/
.history/
.playwright-mcp/

# Dev-only / regenerated artifacts not needed in the worker image
audit-viewer/
assets/
benchmarks/
dist/

# Git
.git/
.gitignore
.gitattributes

# Development files
*.md
!CLAUDE.md
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
.tmp/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Docker files (avoid recursive copying)
Dockerfile*
docker-compose*.yml
.dockerignore

# Test files
test/
tests/
spec/
coverage/

# Documentation (except CLAUDE.md which is needed)
docs/
README.md
LICENSE
CHANGELOG.md