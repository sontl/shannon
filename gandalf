# Parse KEY=value arguments into variables
parse_args() {
  for arg in "$@"; do
    case "$arg" in
      URL=*) URL="${arg#URL=}" ;;
      REPO=*) REPO="${arg#REPO=}" ;;
      APP=*) APP="${arg#APP=}" ;;
      DEVICE=*) DEVICE="${arg#DEVICE=}" ;;
      APK=*) APK="${arg#APK=}" ;;
      CONFIG=*) CONFIG="${arg#CONFIG=}" ;;
      OUTPUT=*) OUTPUT="${arg#OUTPUT=}" ;;
      ID=*) ID="${arg#ID=}" ;;
      CLEAN=*) CLEAN="${arg#CLEAN=}" ;;
      DOWN=*) DOWN="${arg#DOWN=}" ;;
      PIPELINE_TESTING=*) PIPELINE_TESTING="${arg#PIPELINE_TESTING=}" ;;
      REBUILD=*) REBUILD="${arg#REBUILD=}" ;;
      ROUTER=*) ROUTER="${arg#ROUTER=}" ;;
      WORKSPACE=*) WORKSPACE="${arg#WORKSPACE=}" ;;
      PERSONA=*) PERSONA="${arg#PERSONA=}" ;;
      LIST=*) LIST="${arg#LIST=}" ;;
      TRACE=*) TRACE="${arg#TRACE=}" ;;
      INDEX=*) INDEX="${arg#INDEX=}" ;;
      AGENT=*) AGENT="${arg#AGENT=}" ;;
      EVIDENCE=*) EVIDENCE="${arg#EVIDENCE=}" ;;
    esac
  done
}

# Check if Temporal is running and healthy
is_temporal_ready() {
  docker compose -f "$COMPOSE_FILE" $COMPOSE_OVERRIDE exec -T temporal \
    temporal operator cluster health --address localhost:7233 2>/dev/null | grep -q "SERVING"
}

# True if any compose-managed container exists (running OR stopped). After a
# `gandalf stop` (which now only pauses), the containers persist in Exited
# state — this lets ensure_containers resume them instead of recreating.
has_existing_containers() {
  [ -n "$(docker compose -f "$COMPOSE_FILE" $COMPOSE_OVERRIDE ps -aq 2>/dev/null)" ]
}

# Poll until Temporal reports healthy (up to ~60s). Returns 1 on timeout so the
# caller can decide whether to fall back to a full recreate.
wait_for_temporal() {
  echo "Waiting for Temporal to be ready..."
  for i in $(seq 1 30); do
    if is_temporal_ready; then
      echo "Temporal is ready!"
      return 0
    fi
    sleep 2
  done
  return 1
}

# Ensure containers are running with correct mounts
ensure_containers() {
  # If custom OUTPUT_DIR is set, always refresh worker to ensure correct volume mount
  # Docker compose will only recreate if the mount actually changed
  if [ -n "$OUTPUT_DIR" ]; then
    echo "Ensuring worker has correct output mount..."
    docker compose -f "$COMPOSE_FILE" $COMPOSE_OVERRIDE up -d worker 2>/dev/null || true
  fi

  # Quick check: if Temporal is already healthy, we're good
  if is_temporal_ready; then
    return 0
  fi

  # Fast path: containers already exist (paused by `gandalf stop`) and no
  # rebuild was requested — resume them in place. This skips image build +
  # container/network recreation, bringing Temporal back in seconds.
  if [ "$REBUILD" != "true" ] && has_existing_containers; then
    echo "Resuming paused Gandalf containers..."
    docker compose -f "$COMPOSE_FILE" $COMPOSE_OVERRIDE start
    if wait_for_temporal; then
      return 0
    fi
    echo "Resume did not bring Temporal up — recreating containers..."
  fi

  # Slow path: create (or rebuild) containers from scratch.
  echo "Starting Gandalf containers..."
  if [ "$REBUILD" = "true" ]; then
    # Force rebuild without cache (use when code changes aren't being picked up)
    echo "Rebuilding with --no-cache..."
    docker compose -f "$COMPOSE_FILE" $COMPOSE_OVERRIDE build --no-cache worker
  fi
  docker compose -f "$COMPOSE_FILE" $COMPOSE_OVERRIDE up -d --build

  if ! wait_for_temporal; then
    echo "Timeout waiting for Temporal"
    exit 1
  fi
}

cmd_start() {
  parse_args "$@"

  # Detect mobile mode: APP= present means mobile target
  IS_MOBILE=""
  if [ -n "$APP" ]; then
    IS_MOBILE="true"
  fi

  # Detect API mode: config has pipeline.target: api and no APP/REPO
  IS_API=""
  if [ -z "$IS_MOBILE" ] && [ -n "$CONFIG" ] && [ -f "$CONFIG" ]; then
    if grep -qE '^[[:space:]]*target:[[:space:]]*api[[:space:]]*$' "$CONFIG" 2>/dev/null; then
      IS_API="true"
    fi
  fi

  # Detect network mode: config has pipeline.target: network
  IS_NETWORK=""
  if [ -z "$IS_MOBILE" ] && [ -z "$IS_API" ] && [ -n "$CONFIG" ] && [ -f "$CONFIG" ]; then
    if grep -qE '^[[:space:]]*target:[[:space:]]*network[[:space:]]*$' "$CONFIG" 2>/dev/null; then
      IS_NETWORK="true"
    fi
  fi

  # REPO is required for every target (provides documentation as input).
  if [ -z "$REPO" ]; then
    echo "ERROR: REPO is required (folder under ./repos/ with target documentation)"
    echo "Usage: ./gandalf start URL=<url> REPO=<name>"
    echo "       ./gandalf start APP=<bundle-id> DEVICE=<device-id> REPO=<name> CONFIG=<path>"
    echo "       ./gandalf start URL=<api-url> REPO=<name> CONFIG=<api-config>"
    exit 1
  fi

  if [ -n "$IS_MOBILE" ]; then
    if [ -z "$DEVICE" ]; then
      echo "ERROR: DEVICE is required for mobile targets"
      echo "Usage: ./gandalf start APP=<bundle-id> DEVICE=<device-id> REPO=<name> CONFIG=<path>"
      exit 1
    fi
  elif [ -n "$IS_API" ]; then
    if [ -z "$URL" ]; then
      echo "ERROR: URL is required for API targets"
      echo "Usage: ./gandalf start URL=<api-url> REPO=<name> CONFIG=<path>"
      exit 1
    fi
  elif [ -n "$IS_NETWORK" ]; then
    # Network target: scope.targets in the config IS the addressing. URL is
    # optional for network engagements (a customer "landing URL" is just
    # documentation — the agent uses the scope list from config).
    :
  else
    if [ -z "$URL" ]; then
      echo "ERROR: URL is required for web targets (or use APP= for mobile, CONFIG with pipeline.target=api, or CONFIG with pipeline.target=network)"
      echo "Usage: ./gandalf start URL=<url> REPO=<name>"
      exit 1
    fi
  fi

  # Check for API key (Bedrock, Vertex, router, and custom base URL modes can bypass this)
  if [ -z "$ANTHROPIC_API_KEY" ] && [ -z "$CLAUDE_CODE_OAUTH_TOKEN" ]; then
    if [ -n "$ANTHROPIC_BASE_URL" ] && [ -n "$ANTHROPIC_AUTH_TOKEN" ]; then
      # Custom base URL mode — use auth token as API key for SDK initialization
      echo "Using custom base URL: $ANTHROPIC_BASE_URL"
    elif [ "$CLAUDE_CODE_USE_BEDROCK" = "1" ]; then
      # Bedrock mode — validate required AWS credentials
      MISSING=""
      [ -z "$AWS_REGION" ] && MISSING="$MISSING AWS_REGION"
      [ -z "$AWS_BEARER_TOKEN_BEDROCK" ] && MISSING="$MISSING AWS_BEARER_TOKEN_BEDROCK"
      [ -z "$ANTHROPIC_SMALL_MODEL" ] && MISSING="$MISSING ANTHROPIC_SMALL_MODEL"
      [ -z "$ANTHROPIC_MEDIUM_MODEL" ] && MISSING="$MISSING ANTHROPIC_MEDIUM_MODEL"
      [ -z "$ANTHROPIC_LARGE_MODEL" ] && MISSING="$MISSING ANTHROPIC_LARGE_MODEL"
      if [ -n "$MISSING" ]; then
        echo "ERROR: Bedrock mode requires the following env vars in .env:$MISSING"
        exit 1
      fi
    elif [ "$CLAUDE_CODE_USE_VERTEX" = "1" ]; then
      # Vertex AI mode — validate required GCP credentials
      MISSING=""
      [ -z "$CLOUD_ML_REGION" ] && MISSING="$MISSING CLOUD_ML_REGION"
      [ -z "$ANTHROPIC_VERTEX_PROJECT_ID" ] && MISSING="$MISSING ANTHROPIC_VERTEX_PROJECT_ID"
      [ -z "$ANTHROPIC_SMALL_MODEL" ] && MISSING="$MISSING ANTHROPIC_SMALL_MODEL"
      [ -z "$ANTHROPIC_MEDIUM_MODEL" ] && MISSING="$MISSING ANTHROPIC_MEDIUM_MODEL"
      [ -z "$ANTHROPIC_LARGE_MODEL" ] && MISSING="$MISSING ANTHROPIC_LARGE_MODEL"
      if [ -n "$MISSING" ]; then
        echo "ERROR: Vertex AI mode requires the following env vars in .env:$MISSING"
        exit 1
      fi
      # Validate service account key file (must be inside ./credentials/ for Docker mount)
      if [ -z "$GOOGLE_APPLICATION_CREDENTIALS" ]; then
        echo "ERROR: Vertex AI mode requires GOOGLE_APPLICATION_CREDENTIALS in .env"
        echo "       Place your service account key in ./credentials/ and set:"
        echo "       GOOGLE_APPLICATION_CREDENTIALS=./credentials/gcp-sa-key.json"
        exit 1
      fi
      if [ ! -f "$GOOGLE_APPLICATION_CREDENTIALS" ]; then
        echo "ERROR: Service account key file not found: $GOOGLE_APPLICATION_CREDENTIALS"
        echo "       Download a key from the GCP Console (IAM > Service Accounts > Keys)"
        exit 1
      fi
    elif [ "$ROUTER" = "true" ] && { [ -n "$OPENAI_API_KEY" ] || [ -n "$OPENROUTER_API_KEY" ]; }; then
      # Router mode with alternative provider - set a placeholder for SDK init
      export ANTHROPIC_API_KEY="router-mode"
    else
      echo "ERROR: Set ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN in .env"
      echo "       (or use CLAUDE_CODE_USE_BEDROCK=1 for AWS Bedrock,"
      echo "        CLAUDE_CODE_USE_VERTEX=1 for Google Vertex AI,"
      echo "        or ROUTER=true with OPENAI_API_KEY or OPENROUTER_API_KEY)"
      exit 1
    fi
  fi

  # Determine container path for REPO (all targets — REPO holds documentation).
  # - If REPO is already a container path (/benchmarks/*, /repos/*), use as-is
  # - Otherwise, treat as a folder name under ./repos/ (mounted at /repos in container)
  case "$REPO" in
    /benchmarks/*|/repos/*)
      CONTAINER_REPO="$REPO"
      ;;
    *)
      if [ ! -d "./repos/$REPO" ]; then
        echo "ERROR: Documentation folder not found at ./repos/$REPO"
        echo ""
        echo "Place your target documentation under the ./repos/ directory"
        exit 1
      fi
      CONTAINER_REPO="/repos/$REPO"
      ;;
  esac

  # Handle custom OUTPUT directory
  # Export OUTPUT_DIR for docker-compose volume mount BEFORE starting containers
  if [ -n "$OUTPUT" ]; then
    # Create output directory with write permissions for container user (UID 1001)
    mkdir -p "$OUTPUT"
    chmod 777 "$OUTPUT"
    export OUTPUT_DIR="$OUTPUT"
  fi

  # Handle ROUTER flag - start claude-code-router for multi-model support
  if [ "$ROUTER" = "true" ]; then
    # Check if router is already running
    if docker compose -f "$COMPOSE_FILE" $COMPOSE_OVERRIDE --profile router ps router 2>/dev/null | grep -q "running"; then
      echo "Router already running, skipping startup..."
    else
      echo "Starting claude-code-router..."

      # Check for provider API keys
      if [ -z "$OPENAI_API_KEY" ] && [ -z "$OPENROUTER_API_KEY" ]; then
        echo "WARNING: No provider API key set (OPENAI_API_KEY or OPENROUTER_API_KEY). Router may not work."
      fi

      # Start router with profile
      docker compose -f "$COMPOSE_FILE" $COMPOSE_OVERRIDE --profile router up -d router

      # Give router a few seconds to start (health check disabled for now - TODO: debug later)
      echo "Waiting for router to start..."
      sleep 5
    fi

    # Set ANTHROPIC_BASE_URL to route through router
    export ANTHROPIC_BASE_URL="http://router:3456"
    # Set auth token to match router's APIKEY
    export ANTHROPIC_AUTH_TOKEN="gandalf-router-key"
  fi

  # Export mobile env vars for Docker container
  if [ -n "$IS_MOBILE" ]; then
    export APPIUM_URL="http://host.docker.internal:4723"
    [ -n "$DEVICE" ] && export APPIUM_DEVICE_ID="$DEVICE"
    [ -n "$APK" ] && export APPIUM_APP_PATH="$APK"
  fi

  # Ensure audit-logs directory exists with write permissions for container user (UID 1001).
  # Deliverables are now written under ./audit-logs/<sessionId>/deliverables/, never
  # inside ./repos/<name>/ which is treated as read-only project documentation.
  mkdir -p ./audit-logs ./credentials
  chmod 777 ./audit-logs

  # Ensure containers are running (starts them if needed)
  ensure_containers

  # Build optional args
  ARGS="--repo $CONTAINER_REPO"
  [ -n "$CONFIG" ] && ARGS="$ARGS --config $CONFIG"

  # Pass container path for output (where OUTPUT_DIR is mounted)
  # Also pass display path so client can show the host path to user
  if [ -n "$OUTPUT" ]; then
    ARGS="$ARGS --output /app/output --display-output $OUTPUT"
  fi

  [ "$PIPELINE_TESTING" = "true" ] && ARGS="$ARGS --pipeline-testing"
  [ -n "$WORKSPACE" ] && ARGS="$ARGS --workspace $WORKSPACE"

  # Mobile-specific args
  [ -n "$APP" ] && ARGS="$ARGS --app $APP"
  [ -n "$DEVICE" ] && ARGS="$ARGS --device $DEVICE"
  [ -n "$APK" ] && ARGS="$ARGS --apk $APK"

  # Run the client to submit workflow.
  # Mobile mode passes no positional URL (target identified via APP=).
  # Network mode also skips positional URL when none provided (scope.targets in config is authoritative).
  # Web/API both pass URL as the first positional.
  if [ -n "$IS_MOBILE" ] || { [ -n "$IS_NETWORK" ] && [ -z "$URL" ]; }; then
    docker compose -f "$COMPOSE_FILE" $COMPOSE_OVERRIDE exec -T worker \
      node dist/temporal/client.js $ARGS
  else
    docker compose -f "$COMPOSE_FILE" $COMPOSE_OVERRIDE exec -T worker \
      node dist/temporal/client.js "$URL" $ARGS
  fi
}

cmd_logs() {
  parse_args "$@"

  if [ -z "$ID" ]; then
    echo "ERROR: ID is required"
    echo "Usage: ./gandalf logs ID=<workflow-id>"
    exit 1
  fi

  # Auto-discover the workflow log file
  # 1. Check default location first
  # 2. Search common output directories
  # 3. Fall back to find command
  WORKFLOW_LOG=""

  if [ -f "./audit-logs/${ID}/workflow.log" ]; then
    WORKFLOW_LOG="./audit-logs/${ID}/workflow.log"
  else
    # For resume workflow IDs (e.g. workspace_resume_123), check the original workspace
    WORKSPACE_ID="${ID%%_resume_*}"
    if [ "$WORKSPACE_ID" != "$ID" ] && [ -f "./audit-logs/${WORKSPACE_ID}/workflow.log" ]; then
      WORKFLOW_LOG="./audit-logs/${WORKSPACE_ID}/workflow.log"
    fi

    # For named workspace IDs (e.g. workspace_gandalf-123), check the workspace name
    if [ -z "$WORKFLOW_LOG" ]; then
      WORKSPACE_ID="${ID%%_gandalf-*}"
      if [ "$WORKSPACE_ID" != "$ID" ] && [ -f "./audit-logs/${WORKSPACE_ID}/workflow.log" ]; then
        WORKFLOW_LOG="./audit-logs/${WORKSPACE_ID}/workflow.log"
      fi
    fi

    if [ -z "$WORKFLOW_LOG" ]; then
      # Search for the workflow directory (handles custom OUTPUT paths)
      FOUND=$(find . -maxdepth 3 -path "*/${ID}/workflow.log" -type f 2>/dev/null | head -1)
      if [ -n "$FOUND" ]; then
        WORKFLOW_LOG="$FOUND"
      fi
    fi
  fi

  if [ -n "$WORKFLOW_LOG" ]; then
    echo "Tailing workflow log: $WORKFLOW_LOG"
    tail -f "$WORKFLOW_LOG"
  else
    echo "ERROR: Workflow log not found for ID: $ID"
    echo ""
    echo "Possible causes:"
    echo "  - Workflow hasn't started yet"
    echo "  - Workflow ID is incorrect"
    echo ""
    echo "Check the Temporal Web UI at http://localhost:8233 for workflow details"
    exit 1
  fi
}

cmd_workspaces() {
  # Ensure containers are running (need worker to execute node)
  ensure_containers

  docker compose -f "$COMPOSE_FILE" $COMPOSE_OVERRIDE exec -T worker \
    node dist/temporal/workspaces.js
}

# Cross-platform mtime helper (mac: stat -f, Linux: stat -c)
_mtime() {
  stat -f "%m" "$1" 2>/dev/null || stat -c "%Y" "$1" 2>/dev/null || echo 0
}

# Emit one tab-separated row per trace file, enriched with the agent that
# owned it. Columns: path, persona, hh:mm:ss, agent, attempt, agent_log_basename,
# deliverable_basename, size_bytes. Rows are sorted chronologically. The "owning"
# agent for a trace is the latest agent whose start timestamp (encoded in the
# audit log filename) is <= the trace's timestamp.
_trace_metadata() {
  python3 - "$@" <<'PY'
import os, re, sys
ws = sys.argv[1]
trace_paths = sys.argv[2:]

agents_dir = os.path.join(ws, 'agents')
agents = []
if os.path.isdir(agents_dir):
    for f in os.listdir(agents_dir):
        m = re.match(r'^(\d+)_([\w-]+)_attempt-(\d+)\.log$', f)
        if not m:
            continue
        agents.append((int(m.group(1)), m.group(2), int(m.group(3)), f))
agents.sort()

def owner(ts):
    best = ('', 0, '')
    for ep, name, att, fn in agents:
        if ep <= ts:
            best = (name, att, fn)
        else:
            break
    return best

def deliverable(agent):
    if not agent:
        return ''
    if agent == 'pre-recon':
        return 'code_analysis_deliverable.md'
    if agent == 'recon':
        return 'recon_deliverable.md'
    if agent.endswith('-vuln'):
        return f'{agent[:-len("-vuln")]}_analysis_deliverable.md'
    if agent.endswith('-exploit'):
        return f'{agent[:-len("-exploit")]}_exploitation_evidence.md'
    return ''

import datetime
rows = []
for p in trace_paths:
    bn = os.path.basename(p)
    if not (bn.startswith('trace-') and bn.endswith('.trace')):
        continue
    try:
        ts = int(bn[len('trace-'):-len('.trace')])
    except ValueError:
        continue
    persona = os.path.basename(os.path.dirname(os.path.dirname(p)))
    size = os.path.getsize(p)
    rows.append((ts, p, persona, size))
rows.sort()

for ts, p, persona, size in rows:
    when = datetime.datetime.fromtimestamp(ts / 1000).strftime('%H:%M:%S')
    name, att, fn = owner(ts)
    print('\t'.join([
        p, persona, when,
        name or '-', str(att) if att else '',
        fn or '', deliverable(name), str(size),
    ]))
PY
}

# Repack a Playwright MCP "unpacked" trace into the zip layout that
# `playwright show-trace` expects. The MCP writes per-call files
# trace-<ts>.{trace,network,stacks} sharing a single resources/ folder;
# the viewer needs entries named trace.trace / trace.network / trace.stacks
# plus resources/* in a single zip. Cached next to the source so reopens
# are instant; rebuilt if any source file is newer than the cached zip.
_pack_trace_zip() {
  python3 - "$1" "$2" <<'PY'
import os, sys, zipfile
src_trace, out_zip = sys.argv[1], sys.argv[2]
src_dir = os.path.dirname(src_trace)
base = src_trace[:-len('.trace')]
resources = os.path.join(src_dir, 'resources')
with zipfile.ZipFile(out_zip, 'w', zipfile.ZIP_DEFLATED) as z:
    z.write(src_trace, 'trace.trace')
    for ext in ('.network', '.stacks'):
        p = base + ext
        if os.path.isfile(p):
            z.write(p, 'trace' + ext)
    if os.path.isdir(resources):
        for root, _, files in os.walk(resources):
            for f in files:
                full = os.path.join(root, f)
                rel = os.path.relpath(full, src_dir)
                z.write(full, rel)
PY
}

cmd_trace() {
  parse_args "$@"

  AUDIT_DIR="./audit-logs"
  if [ ! -d "$AUDIT_DIR" ]; then
    echo "ERROR: No audit-logs directory at $AUDIT_DIR"
    exit 1
  fi

  # 1. Resolve workspace — explicit WORKSPACE= wins, otherwise pick the most
  # recently modified workspace that actually has a .runtime/traces tree.
  if [ -z "$WORKSPACE" ]; then
    LATEST=""
    LATEST_MTIME=0
    for ws in "$AUDIT_DIR"/*/; do
      [ -d "${ws}.runtime/traces" ] || continue
      m=$(_mtime "$ws")
      if [ "${m:-0}" -gt "$LATEST_MTIME" ]; then
        LATEST_MTIME=$m
        LATEST=$(basename "$ws")
      fi
    done
    if [ -z "$LATEST" ]; then
      echo "ERROR: No workspaces with Playwright traces under $AUDIT_DIR"
      echo "Hint: traces are only produced by web pentests (Playwright MCP)"
      exit 1
    fi
    WORKSPACE=$LATEST
    echo "No WORKSPACE= given — using most recent: $WORKSPACE"
  fi

  WS_DIR="$AUDIT_DIR/$WORKSPACE"
  TRACES_ROOT="$WS_DIR/.runtime/traces"

  if [ ! -d "$WS_DIR" ]; then
    echo "ERROR: Workspace not found: $WS_DIR"
    echo "Hint: ./gandalf workspaces"
    exit 1
  fi
  if [ ! -d "$TRACES_ROOT" ]; then
    echo "ERROR: No traces found at $TRACES_ROOT"
    echo "Hint: only web pentests record Playwright traces"
    exit 1
  fi

  # 2. Resolve persona scope.
  if [ -n "$PERSONA" ]; then
    if [ ! -d "$TRACES_ROOT/$PERSONA" ]; then
      echo "ERROR: Persona '$PERSONA' has no traces under $TRACES_ROOT"
      echo "Available personas:"
      for d in "$TRACES_ROOT"/*/; do
        [ -d "$d" ] && echo "  - $(basename "$d")"
      done
      exit 1
    fi
    PERSONA_DIRS=("$TRACES_ROOT/$PERSONA")
  else
    PERSONA_DIRS=()
    for d in "$TRACES_ROOT"/*/; do
      [ -d "$d" ] && PERSONA_DIRS+=("${d%/}")
    done
  fi

  # 3. Collect trace files (Playwright unpacked layout: <persona>/traces/*.trace).
  RAW_TRACE_FILES=()
  for d in "${PERSONA_DIRS[@]}"; do
    while IFS= read -r f; do
      [ -n "$f" ] && RAW_TRACE_FILES+=("$f")
    done < <(find "$d/traces" -maxdepth 1 -type f -name "trace-*.trace" 2>/dev/null)
  done

  if [ ${#RAW_TRACE_FILES[@]} -eq 0 ]; then
    echo "ERROR: No trace files (.trace) under $TRACES_ROOT"
    exit 1
  fi

  if ! command -v python3 >/dev/null 2>&1; then
    echo "ERROR: python3 is required for trace metadata + packaging."
    exit 1
  fi

  # 4. Enrich with owning-agent metadata (chronological order).
  # Each META line: path \t persona \t hh:mm:ss \t agent \t attempt \t agent_log \t deliverable_md \t size_bytes
  META=$(_trace_metadata "$WS_DIR" "${RAW_TRACE_FILES[@]}")

  # 5. Optional AGENT= filter.
  if [ -n "$AGENT" ]; then
    META=$(printf '%s\n' "$META" | awk -F'\t' -v a="$AGENT" 'NF && $4 == a { print }')
    if [ -z "$META" ]; then
      echo "ERROR: No traces produced while AGENT='$AGENT' was active."
      echo "Hint: ./gandalf trace WORKSPACE=$WORKSPACE LIST=true  # see agents"
      exit 1
    fi
  fi

  # 6. Rebuild TRACE_FILES from the (possibly filtered) chronological META.
  TRACE_FILES=()
  while IFS=$'\t' read -r path _persona _when _agent _att _fn _deliv _size; do
    [ -n "$path" ] && TRACE_FILES+=("$path")
  done <<< "$META"

  # 7. LIST mode — print enriched table and exit.
  if [ "$LIST" = "true" ]; then
    echo "Workspace: $WORKSPACE"
    [ -n "$AGENT" ] && echo "Agent filter: $AGENT"
    echo "Traces (${#TRACE_FILES[@]}):"
    i=1
    while IFS=$'\t' read -r path persona when agent att _fn _deliv size; do
      [ -z "$path" ] && continue
      sz_h=$(du -h "$path" 2>/dev/null | awk '{print $1}')
      agent_col="$agent"
      [ -n "$att" ] && agent_col="${agent}#${att}"
      printf "  %2d. [%-10s] %s  -> %-22s %s (%s)\n" \
        "$i" "$persona" "$when" "$agent_col" "$(basename "$path")" "$sz_h"
      i=$((i + 1))
    done <<< "$META"
    echo ""
    echo "Open viewer: ./gandalf trace WORKSPACE=$WORKSPACE INDEX=<n>"
    echo "Or evidence: ./gandalf trace WORKSPACE=$WORKSPACE INDEX=<n> EVIDENCE=true"
    exit 0
  fi

  # 8. Pick a single trace — show-trace only accepts one trace per run.
  PICK=""
  if [ -n "$TRACE" ]; then
    for f in "${TRACE_FILES[@]}"; do
      if [ "$(basename "$f")" = "$TRACE" ]; then
        PICK=$f
        break
      fi
    done
    if [ -z "$PICK" ]; then
      echo "ERROR: TRACE='$TRACE' not found in current filter."
      echo "Hint: ./gandalf trace WORKSPACE=$WORKSPACE LIST=true"
      exit 1
    fi
  elif [ -n "$INDEX" ]; then
    if ! [[ "$INDEX" =~ ^[0-9]+$ ]] || [ "$INDEX" -lt 1 ] || [ "$INDEX" -gt ${#TRACE_FILES[@]} ]; then
      echo "ERROR: INDEX=$INDEX is out of range (1..${#TRACE_FILES[@]})"
      exit 1
    fi
    PICK=${TRACE_FILES[$((INDEX - 1))]}
  else
    # Default: last in chronological list (= most recent).
    PICK=${TRACE_FILES[$((${#TRACE_FILES[@]} - 1))]}
    [ -z "$AGENT" ] && echo "No TRACE=/INDEX= given — opening most recent."
    echo "Hint: ./gandalf trace WORKSPACE=$WORKSPACE LIST=true  # see all"
  fi

  # 9. Pull the META row for the picked trace so we can show / link the agent.
  PICK_ROW=$(printf '%s\n' "$META" | awk -F'\t' -v p="$PICK" '$1 == p { print; exit }')
  IFS=$'\t' read -r _ p_persona p_when p_agent p_att p_log p_deliv _ <<< "$PICK_ROW"

  echo "Workspace: $WORKSPACE"
  echo "Persona:   $p_persona"
  echo "Time:      $p_when"
  [ -n "$p_agent" ] && [ "$p_agent" != "-" ] && \
    echo "Agent:     $p_agent${p_att:+ (attempt $p_att)}"
  echo "Trace:     $(basename "$PICK")"

  # 10. EVIDENCE mode — print companion paths, skip viewer.
  if [ "$EVIDENCE" = "true" ]; then
    echo ""
    echo "=== Evidence trail ==="
    if [ -n "$p_log" ] && [ -f "$WS_DIR/agents/$p_log" ]; then
      echo "Agent log:    $WS_DIR/agents/$p_log"
    else
      echo "Agent log:    (none — trace pre-dates any agent in this workspace)"
    fi
    if [ -n "$p_deliv" ] && [ -f "$WS_DIR/deliverables/$p_deliv" ]; then
      echo "Deliverable:  $WS_DIR/deliverables/$p_deliv"
    elif [ -n "$p_deliv" ]; then
      echo "Deliverable:  (expected $p_deliv — not yet written)"
    fi
    # Build the zip too so the user can open the viewer later by hand.
    ZIP_PATH="${PICK%.trace}.zip"
    if [ ! -f "$ZIP_PATH" ] || [ "$(_mtime "$PICK")" -gt "$(_mtime "$ZIP_PATH")" ]; then
      _pack_trace_zip "$PICK" "$ZIP_PATH"
    fi
    echo "Trace zip:    $ZIP_PATH"
    echo ""
    echo "Open viewer with: npx --yes playwright show-trace \"$ZIP_PATH\""
    exit 0
  fi

  # 11. Build (or reuse) a viewer-ready zip alongside the source.
  ZIP_PATH="${PICK%.trace}.zip"
  needs_pack=false
  if [ ! -f "$ZIP_PATH" ]; then
    needs_pack=true
  else
    src_m=$(_mtime "$PICK")
    zip_m=$(_mtime "$ZIP_PATH")
    if [ "${src_m:-0}" -gt "${zip_m:-0}" ]; then
      needs_pack=true
    fi
  fi
  if [ "$needs_pack" = "true" ]; then
    echo "Packing trace zip: $ZIP_PATH"
    _pack_trace_zip "$PICK" "$ZIP_PATH"
  fi

  echo "(first run may take a moment while npx fetches @playwright/test)"
  echo ""
  npx --yes playwright show-trace "$ZIP_PATH"
}

cmd_stop() {
  parse_args "$@"

  if [ "$CLEAN" = "true" ]; then
    # Full teardown: remove containers, networks, AND volumes (Temporal DB lost).
    echo "Removing all containers, networks, and volumes..."
    docker compose -f "$COMPOSE_FILE" $COMPOSE_OVERRIDE --profile router down -v
  elif [ "$DOWN" = "true" ]; then
    # Remove containers + networks but keep volumes (Temporal DB survives).
    echo "Removing containers and networks (volumes preserved)..."
    docker compose -f "$COMPOSE_FILE" $COMPOSE_OVERRIDE --profile router down
  else
    # Default: pause containers in place so the next `start` resumes in seconds
    # instead of recreating images, containers, and networks.
    echo "Pausing containers (next 'start' resumes fast)..."
    echo "  Use 'stop DOWN=true' to remove containers, 'stop CLEAN=true' to also drop volumes."
    docker compose -f "$COMPOSE_FILE" $COMPOSE_OVERRIDE --profile router stop
  fi
}

# Main command dispatch
# Build a polished, branded DOCX/PDF from a report markdown file.
# Thin pass-through to scripts/build-report.py — all args/flags forwarded verbatim.
cmd_report() {
  local SCRIPT_DIR BUILDER
  SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  BUILDER="$SCRIPT_DIR/scripts/build-report.py"
  if [ ! -f "$BUILDER" ]; then
    echo "ERROR: report builder not found at $BUILDER" >&2
    exit 1
  fi
  if ! command -v pandoc >/dev/null 2>&1; then
    echo "ERROR: 'pandoc' is required (brew install pandoc)" >&2
    exit 1
  fi
  if ! python3 -c "import docx" >/dev/null 2>&1; then
    echo "ERROR: python-docx is required (python3 -m pip install python-docx)" >&2
    exit 1
  fi
  python3 "$BUILDER" "$@"
}

case "${1:-help}" in
  start)
    shift
    cmd_start "$@"
    ;;
  report)
    shift
    cmd_report "$@"
    ;;
  logs)
    shift
    cmd_logs "$@"
    ;;
  workspaces)
    shift
    cmd_workspaces
    ;;
  trace)
    shift
    cmd_trace "$@"
    ;;
  stop)
    shift
    cmd_stop "$@"
    ;;
  help|--help|-h|*)
    show_help
    ;;
esac
